{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek",
  "version": "1.0.1",
  "description": "DeepSeek Harness Web UI 的 Linux 桌面壳（Electron + 内置 Node/dsh 运行时）",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Condex <dongzi24@outlook.com>",
  "homepage": "https://github.com/ArKurt/DeepSeek-Harness-Desktop",
  "scripts": {
    "start": "DSH_DESKTOP_DEV=1 electron --ozone-platform=x11 .",
    "dist": "electron-builder --linux AppImage tar.gz deb",
    "pack": "electron-builder --dir",
    "smoke": "node test/server-manager.test.js",
    "test": "node test/window-state.test.js && node test/server-crash.test.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/splash.html",
      "assets/whale.png",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "DeepSeek-${version}-${arch}.${ext}",
      "executableName": "deepseek",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "synopsis": "DeepSeek Harness Desktop",
      "syncDesktopName": true,
      "maintainer": "ArKurt <dongzi24@outlook.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "desktopName": "deepseek.desktop"
}
